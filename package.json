{
  "name": "wormhole",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wormhole - a retro-inspired Tron-style tube flyer",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playtest.json",
    "shoot": "node scripts/shoot.ts",
    "sim": "esbuild scripts/combat-sim.ts --bundle --platform=node --format=esm --outfile=.cache/combat-sim.mjs && node .cache/combat-sim.mjs",
    "sim:levels": "esbuild scripts/levels-sim.ts --bundle --platform=node --format=esm --outfile=.cache/levels-sim.mjs && node .cache/levels-sim.mjs",
    "playtest": "esbuild scripts/playtest.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/playtest.mjs && node .cache/playtest.mjs",
    "playtest:baseline": "npm run playtest -- --matrix baseline --runs 60 --seed 1 --max-seconds 900 --out playtest/baseline.json",
    "playtest:compare": "npm run playtest -- --matrix baseline --runs 60 --seed 1 --max-seconds 900 --compare playtest/baseline.json",
    "playtest:next": "npm run playtest -- --matrix next --runs 60 --seed 1 --max-seconds 900 --levels --out playtest/next-level.json",
    "playtest:live": "esbuild scripts/playtest/live-agent.ts --bundle --format=iife --log-level=warning --outfile=.cache/live-agent.js && node scripts/playtest-live.ts",
    "sim:fields": "esbuild scripts/fields-sim.ts --bundle --platform=node --format=esm --outfile=.cache/fields-sim.mjs && node .cache/fields-sim.mjs",
    "sim:sequence": "esbuild scripts/sequence-sim.ts --bundle --platform=node --format=esm --outfile=.cache/sequence-sim.mjs && node .cache/sequence-sim.mjs",
    "sim:feel": "esbuild scripts/feel-sim.ts --bundle --platform=node --format=esm --outfile=.cache/feel-sim.mjs && node .cache/feel-sim.mjs",
    "sim:swing": "esbuild scripts/swing-sim.ts --bundle --platform=node --format=esm --outfile=.cache/swing-sim.mjs && node .cache/swing-sim.mjs"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
