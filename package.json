{
  "name": "wormhole",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wormhole - a retro-inspired Tron-style tube flyer",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.playtest.json",
    "shoot": "node scripts/shoot.ts",
    "sim": "node scripts/run.mjs combat-sim",
    "sim:levels": "node scripts/run.mjs levels-sim",
    "playtest": "node scripts/run.mjs playtest",
    "playtest:baseline": "npm run playtest -- --matrix baseline --runs 60 --seed 1 --max-seconds 900 --out playtest/baseline.json",
    "playtest:compare": "npm run playtest -- --matrix baseline --runs 60 --seed 1 --max-seconds 900 --compare playtest/baseline.json",
    "playtest:next": "npm run playtest -- --matrix next --runs 60 --seed 1 --max-seconds 900 --levels --out playtest/next-level.json",
    "playtest:live": "esbuild scripts/playtest/live-agent.ts --bundle --format=iife --log-level=warning --outfile=.cache/live-agent.js && node scripts/run.mjs playtest-live",
    "sim:fields": "node scripts/run.mjs fields-sim",
    "sim:sequence": "node scripts/run.mjs sequence-sim",
    "sim:feel": "node scripts/run.mjs feel-sim"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
